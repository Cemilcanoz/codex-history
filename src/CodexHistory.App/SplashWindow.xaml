<Window x:Class="CodexHistory.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Geçmişi" Width="420" Height="220"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        AllowsTransparency="False">
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="32">
    <StackPanel VerticalAlignment="Center">
      <TextBlock Text="CODEX HISTORY" FontFamily="Consolas" FontSize="25" FontWeight="Bold"
                 Foreground="{DynamicResource TextBrush}" />
      <Border Width="52" Height="3" HorizontalAlignment="Left" Margin="0,17,0,17"
              Background="{DynamicResource AccentBrush}" />
      <TextBlock Text="Yerel geçmiş gezgini hazırlanıyor…" FontSize="13"
                 Foreground="{DynamicResource MutedBrush}" />
    </StackPanel>
  </Border>
</Window>
